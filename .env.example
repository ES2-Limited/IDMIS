DATABASE_URL=postgresql://idmis:idmis@localhost:5432/idmis
# Maximum Postgres connection pool size per process (default: 20).
# NOTE: The total pool across api + worker (x replicas) must stay under PostgreSQL max_connections (e.g. 100).
DB_POOL_MAX=20
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=idmis
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_SECRET=supersecret-placeholder-jwt-secret
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Initial System Administrator Seed Credentials
# Generate the Argon2id hash with: pnpm db:hash-password
ADMIN_EMAIL=admin@idmis.gov.ng
ADMIN_PASSWORD_HASH=

# M&E Compute job debounce window in milliseconds (default: 60000 = 1 minute)
ME_COMPUTE_DEBOUNCE_MS=60000

# Whether administrators are enforced to set up TOTP two-factor authentication (default: true).
# Set to false to allow admins without TOTP to sign in without mandatory enrollment.
AUTH_TOTP_ENFORCE_ADMINS=true

# Master switch for TOTP / 2FA. Set to false to disable OTP/TOTP challenges across all environments (including production).
AUTH_TOTP_ENABLED=false


