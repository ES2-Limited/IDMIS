{
  "name": "@idmis/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./authz": "./src/authz/index.ts",
    "./security": "./src/security/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/cli/seed.ts",
    "db:seed:load": "tsx src/cli/seed-load.ts",
    "db:seed:reference": "tsx src/cli/seed-reference.ts",
    "db:hash-password": "tsx scripts/hash-password.ts",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js",
    "seed:load": "node dist/cli/seed-load.js",
    "seed:reference": "node dist/cli/seed-reference.js",
    "release": "node dist/release.js"
  },
  "dependencies": {
    "@idmis/contracts": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@idmis/config": "workspace:*",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
