{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile --prod=false && pnpm turbo run build --filter=@idmis/api",
    "watchPatterns": ["apps/api/**", "packages/**", "package.json", "pnpm-lock.yaml", "turbo.json"]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/main.js",
    "preDeployCommand": "node packages/db/dist/migrate.js && node packages/db/dist/seed.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}
