{
  "name": "idmis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @idmis/db db:generate",
    "db:migrate": "pnpm --filter @idmis/db db:migrate",
    "db:seed": "pnpm --filter @idmis/db db:seed",
    "db:hash-password": "pnpm --filter @idmis/db db:hash-password",
    "services:up": "docker compose -f infra/compose.dev.yml up -d",
    "services:down": "docker compose -f infra/compose.dev.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "vitest": "^5.0.5"
  }
}
